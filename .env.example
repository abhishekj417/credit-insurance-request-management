# entra: require Microsoft App Service authentication headers (default; use for every shared or hosted deployment)
# development: NO AUTHENTICATION - every caller is treated as Administrator. Local, single-user pilots only.
#              The server refuses to start with AUTH_MODE=development when NODE_ENV=production.
AUTH_MODE=entra
PORT=4173
CREDITFLOW_DB=./data/credit-insurance.db

# Per-user requests allowed per minute (optional)
# RATE_LIMIT_READS=300
# RATE_LIMIT_WRITES=30

# Add approved SharePoint/Teams origins when embedding, for example:
# FRAME_ANCESTORS='self' https://company.sharepoint.com https://teams.microsoft.com
FRAME_ANCESTORS='self'
